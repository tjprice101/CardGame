// ---------------------------------------------------------------------------
// Shared rendering helpers (same logic as Neutrality preview)
// ---------------------------------------------------------------------------

type Tier = 'Common' | 'Rare' | 'Epic' | 'Legendary' | 'Eternal' | 'Infinite';
const TIER_ORDER: Tier[] = ['Common', 'Rare', 'Epic', 'Legendary', 'Eternal', 'Infinite'];
const TYPE_ORDER = ['Ophanim', 'Seraphim', 'Cherubim', 'Angel'];

function rarityGlyph(rarity: string): string {
  switch (rarity) {
    case 'Common':   return '◈';
    case 'Rare':     return '◆';
    case 'Epic':     return '✦';
    case 'Legendary': return '★';
    case 'Eternal':  return '♾';
    case 'Infinite': return '∞';
    default:         return '·';
  }
}

function descriptionFor(card: CardDefinition): string {
  try {
    const canon = getCanonicalCardDescription(card as Parameters<typeof getCanonicalCardDescription>[0]);
    if (canon && !canon.includes('undefined')) return canon;
  } catch { /* fall through */ }
  return card.description ?? '(no description)';
}

function formatSeraphimAttacks(card: SeraphimDefinition): string {
  const attacks = card.attacks;
  if (!attacks) return '';
  const unsyn = getCanonicalAttackDescription(attacks.unsynergized);
  const syn   = getCanonicalAttackDescription(attacks.synergized);
  return [
    `  - **${attacks.unsynergized.name}** (Unsynergized): ${unsyn}`,
    `  - **${attacks.synergized.name}** (Synergized): ${syn}`,
  ].join('\n');
}

function formatAngelCard(card: AngelDefinition): string {
  const parts: string[] = [];

  // Summon cost
  const costNames = card.summonCost.map(id => CardRegistry.get(id)?.name ?? id);
  parts.push('**Summon**: ' + costNames.join(' + '));

  // Activated ability
  if (card.activatedAbility) {
    let abilityText = card.activatedAbility.description;
    try {
      const canon = getCanonicalActivatedAbilityDescription(card as Parameters<typeof getCanonicalActivatedAbilityDescription>[0]);
      if (canon && !canon.includes('undefined')) abilityText = canon;
    } catch { /* keep authored */ }
    parts.push(`**Ability (${card.activatedAbility.name})**: After ${card.activatedAbility.cardsPlayedRequirement} cards played: ${abilityText}`);
  }

  // Attacks
  if (card.attacks) {
    const primary = getCanonicalAttackDescription(card.attacks.primary);
    const exalted = getCanonicalAttackDescription(card.attacks.exalted);
    parts.push(
      '**Attacks**:',
      `  - **${card.attacks.primary.name}** (Primary): ${primary}`,
      `  - **${card.attacks.exalted.name}** (Exalted): ${exalted}`,
    );
  }

  return parts.join('\n\n');
}

function renderCard(card: CardDefinition): string {
  const glyph = rarityGlyph(card.rarity);
  const lines: string[] = [
    `### ${glyph} ${card.name} \`${card.definitionId}\``,
    `**Rarity**: ${card.rarity} · **Type**: ${card.type}`,
    '',
    descriptionFor(card),
  ];

  if (card.type === 'Seraphim' && (card as SeraphimDefinition).attacks) {
    const attackLines = formatSeraphimAttacks(card as SeraphimDefinition);
    if (attackLines) {
      lines.push('', '**Attacks**:', attackLines);
    }
  }

  if (card.type === 'Angel') {
    lines.push('', formatAngelCard(card as AngelDefinition));
  }

  return lines.join('\n');
}

function renderGroup(type: string, cards: CardDefinition[]): string {
  const sorted = [...cards].sort((a, b) => {
    const ra = TIER_ORDER.indexOf(a.rarity as Tier);
    const rb = TIER_ORDER.indexOf(b.rarity as Tier);
    return ra !== rb ? ra - rb : a.name.localeCompare(b.name);
  });

  return [
    `## ${type}s`,
    '',
    ...sorted.flatMap(card => [renderCard(card), '', '---', '']),
  ].join('\n');
}

// ---------------------------------------------------------------------------
// Per-set document builder
// ---------------------------------------------------------------------------

function buildSetDoc(meta: SetMeta, allCards: CardDefinition[]): string {
  const setCards = allCards.filter(c => c.element === meta.element);
  if (setCards.length === 0) return '';

  const baseCards    = setCards.filter(c => c.rarity !== 'Eternal' && c.rarity !== 'Infinite');
  const eternalCards = setCards.filter(c => c.rarity === 'Eternal');
  const infiniteCards = setCards.filter(c => c.rarity === 'Infinite');

  // Group base cards by type
  const byType = new Map<string, CardDefinition[]>();
  for (const card of baseCards) {
    const t = card.type;
    if (!byType.has(t)) byType.set(t, []);
    byType.get(t)!.push(card);
  }

  const sections: string[] = [
    `# ${meta.displayName} — Card Effects`,
    '',
    `> **Set**: ${meta.displayName} · **Element**: \`${meta.element}\``,
    `> **Mechanics**: ${meta.mechLine}`,
    `>`,
    `> ${meta.resourceSummary}`,
    '',
    `> *Auto-generated from \`CardRegistry\`. Run \`npm run docs:cards\` to refresh.*`,
    '',
  ];

  for (const type of TYPE_ORDER) {
    const cards = byType.get(type);
    if (cards && cards.length > 0) {
      sections.push(renderGroup(type, cards));
    }
  }

  if (eternalCards.length > 0) {
    sections.push('# Eternal Tier', '');
    const etByType = new Map<string, CardDefinition[]>();
    for (const c of eternalCards) {
      if (!etByType.has(c.type)) etByType.set(c.type, []);
      etByType.get(c.type)!.push(c);
    }
    for (const type of TYPE_ORDER) {
      const cards = etByType.get(type);
      if (cards && cards.length > 0) sections.push(renderGroup(type, cards));
    }
  }

  if (infiniteCards.length > 0) {
    sections.push('# Infinite Tier', '');
    const infByType = new Map<string, CardDefinition[]>();
    for (const c of infiniteCards) {
      if (!infByType.has(c.type)) infByType.set(c.type, []);
      infByType.get(c.type)!.push(c);
    }
    for (const type of TYPE_ORDER) {
      const cards = infByType.get(type);
      if (cards && cards.length > 0) sections.push(renderGroup(type, cards));
    }
  }

  return sections.join('\n');
}

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

const allCards = CardRegistry.getAll();
let generated = 0;

for (const meta of SETS) {
  const doc = buildSetDoc(meta, allCards);
  if (!doc) {
    console.log(`  (skipped ${meta.displayName} — no cards found for element '${meta.element}')`);
    continue;
  }

  const dir  = resolve('..', 'Card Effects', meta.folderName);
  const file = resolve(dir, `${meta.folderName} Card Effects.md`);
  mkdirSync(dir, { recursive: true });
  writeFileSync(file, doc, { encoding: 'utf8' });

  const count = allCards.filter(c => c.element === meta.element).length;
  console.log(`  ✓ ${meta.displayName} (${count} cards) → ${file}`);
  generated++;
}

console.log(`\nDone — generated ${generated}/${SETS.length} sets.`);
