/**
 * generate-card-effects-docs.mts
 *
 * Generates Card Effects markdown files for all 15 playable sets.
 * Output: workspace-root/Card Effects/<Set Name>/<Set Name> Card Effects.md
 *
 * Usage:  npx tsx scripts/generate-card-effects-docs.mts
 *
 * Files are OVERWRITTEN on each run — do not hand-edit them.
 * To change card descriptions, edit the source .ts card files and run this
 * script again (or `npm run docs:cards`).
 */

